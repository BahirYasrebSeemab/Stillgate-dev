{
  "name": "stillgate",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && bun run --filter @asd/manager build:ui",
    "typecheck": "tsc -b && tsc -p packages/shared/tsconfig.test.json && tsc -p packages/agent-service/tsconfig.test.json && tsc -p packages/manager/tsconfig.test.json && tsc -p packages/manager/tsconfig.renderer.json",
    "test": "bun test && bun run test:node",
    "test:node": "tsc -b && tsc -p packages/agent-service/tsconfig.nodetest.json && tsc -p packages/manager/tsconfig.nodetest.json && node --test \"packages/*/dist-test/**/*.nodetest.js\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "24",
    "typescript": "^7.0.2"
  }
}
