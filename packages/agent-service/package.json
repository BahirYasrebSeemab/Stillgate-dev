{
  "name": "@asd/agent-service",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "exports": {
    "./server-link": {
      "types": "./dist/server-link/index.d.ts",
      "default": "./dist/server-link/index.js"
    },
    "./shell-ipc": {
      "types": "./dist/shell-ipc/server.d.ts",
      "default": "./dist/shell-ipc/server.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "dev": "ASD_DATA_DIR=../../.dev-data/agent ASD_LOG_ECHO=1 node dist/main.js",
    "bundle": "bun build src/main.ts src/cli.ts --target=node --format=cjs --outdir=release/agent --entry-naming=[name].js --external bufferutil --external utf-8-validate"
  },
  "dependencies": {
    "@asd/shared": "workspace:*",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "selfsigned": "^5.5.0"
  }
}
