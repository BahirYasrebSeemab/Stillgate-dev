{
  // React UI (browser side). Type-check only: Vite does the actual bundling.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": { "@asd/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src/renderer", "src/common"]
}
