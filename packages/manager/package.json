{
  "name": "@asd/manager",
  "version": "0.1.0",
  "private": true,
  "description": "ASD Lab Lock manager: agent server + manager UI",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:ui": "vite build",
    "start": "electron .",
    "dev:ui": "vite",
    "dev": "ASD_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "bun run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@asd/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asd/agent-service": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.2"
  }
}
